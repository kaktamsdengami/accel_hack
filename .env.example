# Copy to .env (git-ignored) and fill in. Never commit .env, never paste keys into chat.

# --- Models ---
ANTHROPIC_API_KEY=            # console.anthropic.com -> API Keys (product budget, $100)
OPENAI_API_KEY=               # platform.openai.com -> API keys ($50, expires 30 days after redemption)
# ElevenLabs: subscription only, voice-over is made in the web app (T29), no key needed

# --- Search ---
KEENABLE_API_KEY=             # app.keenable.ai -> API key ($1000 credits)

# --- Modal (GPU) ---
MODAL_TOKEN_ID=               # modal.com -> Settings -> API tokens (or run `modal setup` once)
MODAL_TOKEN_SECRET=

# --- Aiven (console.aiven.io -> each service -> Overview -> Connection information) ---
PG_URI=                       # PostgreSQL service URI (postgres://...)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=              # HTTPS port
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
VALKEY_URI=                   # rediss://...
KAFKA_BOOTSTRAP=              # host:port
KAFKA_CA_PATH=data/certs/kafka-ca.pem          # download from the Kafka service page
KAFKA_CERT_PATH=data/certs/kafka-service.cert
KAFKA_KEY_PATH=data/certs/kafka-service.key

# --- Budget guards ---
MATCH_BUDGET_USD=3            # hard cap of model spend per match (tune in T14)

# --- Aiven API (scripts/aiven_env.py fills the values above from these) ---
AIVEN_TOKEN=                  # console.aiven.io -> profile -> Tokens
AIVEN_PROJECT=
